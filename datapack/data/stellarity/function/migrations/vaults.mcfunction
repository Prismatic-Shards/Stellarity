# Vault Migrations (Pack format 26.3 / MC 1.21.x)
# Fixes vaults with legacy v5 translations or broken #CC26FF lore.
# Note: Never match #eaa7ff or item.stellarity.* in replace, otherwise vaults continuously reset!

# --- Winged Key (Elytra Vault) ---
execute at @a[predicate=stellarity:item/holding/winged_key] run fill ~5 ~3 ~5 ~-5 ~-3 ~-5 vault[ominous=true]{config:{loot_table:"stellarity:end_city/vault/elytra",override_loot_table_to_display:"stellarity:end_city/vault/elytra",key_item:{components:{"minecraft:item_name":{translate:"item.stellarity.winged_key"},"minecraft:lore":["",{color:"#EEEEEE",italic:0b,translate:"item.stellarity.winged_key.description"},"",{color:"#EAA7FF",italic:0b,translate:"Stellarity",font:"stellarity:tooltip"}],"minecraft:item_model":"stellarity:winged_key","minecraft:rarity":"rare","minecraft:custom_data":{"stellarity:item":"winged_key"}},count:1,id:"minecraft:ominous_trial_key"}}} replace vault[ominous=true]{config:{key_item:{components:{"minecraft:lore":["",{color:"#CC26FF",italic:1b,translate:"Stellarity"}]}}}}

execute at @a[predicate=stellarity:item/holding/winged_key] run fill ~5 ~3 ~5 ~-5 ~-3 ~-5 vault[ominous=true]{config:{loot_table:"stellarity:end_city/vault/elytra",override_loot_table_to_display:"stellarity:end_city/vault/elytra",key_item:{components:{"minecraft:item_name":{translate:"item.stellarity.winged_key"},"minecraft:lore":["",{color:"#EEEEEE",italic:0b,translate:"item.stellarity.winged_key.description"},"",{color:"#EAA7FF",italic:0b,translate:"Stellarity",font:"stellarity:tooltip"}],"minecraft:item_model":"stellarity:winged_key","minecraft:rarity":"rare","minecraft:custom_data":{"stellarity:item":"winged_key"}},count:1,id:"minecraft:ominous_trial_key"}}} replace vault[ominous=true]{config:{key_item:{components:{"minecraft:item_name":'{"translate":"stellarity.item.materials.keys.winged"}'}}}}

execute at @a[predicate=stellarity:item/holding/winged_key] run fill ~5 ~3 ~5 ~-5 ~-3 ~-5 vault[ominous=true]{config:{loot_table:"stellarity:end_city/vault/elytra",override_loot_table_to_display:"stellarity:end_city/vault/elytra",key_item:{components:{"minecraft:item_name":{translate:"item.stellarity.winged_key"},"minecraft:lore":["",{color:"#EEEEEE",italic:0b,translate:"item.stellarity.winged_key.description"},"",{color:"#EAA7FF",italic:0b,translate:"Stellarity",font:"stellarity:tooltip"}],"minecraft:item_model":"stellarity:winged_key","minecraft:rarity":"rare","minecraft:custom_data":{"stellarity:item":"winged_key"}},count:1,id:"minecraft:ominous_trial_key"}}} replace vault[ominous=true]{config:{key_item:{components:{"minecraft:item_name":'{"fallback":"Winged Key","translate":"stellarity.item.materials.keys.winged"}'}}}}

