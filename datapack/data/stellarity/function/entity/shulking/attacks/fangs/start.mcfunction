# Spawn concentric rings of evoker fangs
playsound minecraft:entity.evoker.prepare_attack hostile @a ~ ~ ~ 1.5 0.7

function stellarity:entity/shulking/attacks/fangs/ring {dist:4,warmup:10}
function stellarity:entity/shulking/attacks/fangs/ring {dist:7,warmup:18}
function stellarity:entity/shulking/attacks/fangs/ring {dist:10,warmup:26}
function stellarity:entity/shulking/attacks/fangs/ring {dist:13,warmup:34}
