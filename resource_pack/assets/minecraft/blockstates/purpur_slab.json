{
  "variants": {
    "type=bottom": {
      "type": "polytone:expression",
      "fabric:type": "polytone:expression",
      "cases": [
        {
          "when": "o.canSeeSky() && (o.biome().contains('frost') || o.biome().contains('frozen'))",
          "model": {
            "model": "stellarity:block/snowy_purpur_slab"
          }
        }
      ],
      "fallback": {
        "model": "minecraft:block/purpur_slab"
      }
    },
    "type=double": {
      "model": "minecraft:block/purpur_block"
    },
    "type=top": {
      "model": "minecraft:block/purpur_slab_top"
    }
  }
}
