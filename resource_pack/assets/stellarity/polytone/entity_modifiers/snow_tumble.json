{
  "targets": [
    "minecraft:player"
  ],
  "emitters": [
    {
      "particle": "stellarity:snow_tumble",
      "max_distance": 32,
      "chance": "(config('stellarity:snow_tumble') != '§cOFF') && (!o.biome().contains('caves') && (o.biome().contains('frost') || o.biome().contains('frozen') || o.biome().contains('tundra') || o.biome().contains('crystal_crags'))) ? 0.35 : 0.0",
      "count": 1,
      "x": "r.rand(-14.0, 14.0)",
      "y": "r.rand(0.5, 3.5)",
      "z": "r.rand(-14.0, 14.0)"
    },
    {
      "particle": "stellarity:ice_tumble",
      "max_distance": 32,
      "chance": "(config('stellarity:snow_tumble') != '§cOFF') && (!o.biome().contains('caves') && (o.biome().contains('frost') || o.biome().contains('frozen') || o.biome().contains('tundra') || o.biome().contains('crystal_crags'))) ? 0.25 : 0.0",
      "count": 1,
      "x": "r.rand(-14.0, 14.0)",
      "y": "r.rand(0.5, 3.5)",
      "z": "r.rand(-14.0, 14.0)"
    }
  ]
}
