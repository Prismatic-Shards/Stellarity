{
  "type": "custom",
  "initializer": {
    "lifetime": "60 + 30 * rand()",
    "alpha": "0.1",
    "size": "0",
    "custom": "rand()",
    "red": "0.12 + rand() * 0.14",
    "green": "0.92 + rand() * 0.08",
    "blue": "0.86 + rand() * 0.14",
    "hitbox_size": 0.15
  },
  "ticker": {
    "dx": "DX + 0.004 * sin(0.07 * AGE + CUSTOM * 6.28)",
    "dy": "DY",
    "dz": "DZ + 0.004 * cos(0.07 * AGE + CUSTOM * 6.28)",
    "size": "(0.09 + CUSTOM * 0.04) * sin((pi / LIFETIME) * AGE)",
    "alpha": "0.88 * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 34"
  },
  "light_level": 15,
  "render_type": "additive_translucent",
  "has_physics": false
}
