{
  "type": "custom",
  "initializer": {
    "lifetime": "280",
    "size": "min(128 * (RENDER_DISTANCE / 16), 512)",
    "alpha": "0",
    "custom": "rand()"
  },
  "ticker": {
    "alpha": "(0.12 + 0.08 * sin(AGE * 0.025 + CUSTOM * 2 * pi)) * sin((pi / LIFETIME) * AGE)",
