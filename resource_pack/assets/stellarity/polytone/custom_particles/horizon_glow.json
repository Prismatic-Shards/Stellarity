    "remove_condition": "sqrt(DISTANCE_SQUARED) > 1000"
  },
  "render_type": "additive_translucent",
  "liquid_affinity": "any",
  "random_sprite": true,
  "rotation_mode": "look_at_y",
  "exclusion_radius": 0,
  "has_physics": false,
  "kill_on_contact": false,
  "force_spawn": true,
  "light_level": 15,
  "kill_when_still": false,
  "offset": [
    0,
    -5,
    0
  ]
}
