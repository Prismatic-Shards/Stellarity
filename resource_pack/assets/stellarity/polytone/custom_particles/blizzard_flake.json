{
  "type": "custom",
  "initializer": {
    "lifetime": "40 + 25 * rand()",
    "alpha": "0",
    "size": "0",
    "red": "0.92",
    "green": "0.96",
    "blue": "1.0",
    "roll": "rand() * 6.28",
    "custom": "rand()"
  },
  "ticker": {
    "dx": "-1.6 - CUSTOM * 0.9",
