    "size": "(0.22 + CUSTOM * 0.14) * sin((pi / LIFETIME) * AGE)",
    "alpha": "0.90 * sin((pi / LIFETIME) * AGE)",
    "roll": "ROLL + 0.08",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 45"
  },
  "rotation_mode": "movement_aligned",
  "render_type": "translucent",
  "has_physics": false
}
