{
  "type": "custom",
  "initializer": {
    "lifetime": "140 + 50 * rand()",
    "alpha": "0",
    "size": "4.5 + 1.5 * rand()",
    "custom": "rand()",
    "red": "0.10",
    "green": "0.06",
    "blue": "0.18",
    "hitbox_size": 0.1
  },
  "ticker": {
    "alpha": "(0.16 + 0.05 * CUSTOM) * sin((pi / LIFETIME) * AGE)",
    "dx": "0.005 * sin(0.01 * AGE + CUSTOM * 6.28)",
    "dy": "-0.002",
    "dz": "0.005 * cos(0.01 * AGE + CUSTOM * 6.28)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 36"
  },
  "render_type": "translucent",
  "rotation_mode": "look_at_xyz",
  "exclusion_radius": 2,
  "has_physics": false,
  "liquid_affinity": "any"
}
