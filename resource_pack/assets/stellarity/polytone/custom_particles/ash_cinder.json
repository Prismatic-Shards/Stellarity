{
  "type": "custom",
  "initializer": {
    "lifetime": "50 + 25 * rand()",
    "alpha": "0.1",
    "size": "0",
    "custom": "rand()",
    "red": "0.96 + rand() * 0.04",
    "green": "0.34 + rand() * 0.22",
    "blue": "0.15 + rand() * 0.15",
    "hitbox_size": 0.15
  },
  "ticker": {
    "dx": "DX + 0.003 * sin(0.1 * AGE + CUSTOM * 6.28)",
    "dy": "DY",
    "dz": "DZ + 0.003 * cos(0.1 * AGE + CUSTOM * 6.28)",
    "size": "(0.10 + CUSTOM * 0.04) * sin((pi / LIFETIME) * AGE)",
    "alpha": "0.88 * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 32"
  },
  "light_level": 15,
  "render_type": "additive_translucent",
  "has_physics": false
}
