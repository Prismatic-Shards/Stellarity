{
  "type": "custom",
  "initializer": {
    "lifetime": "90 + 40 * rand()",
    "alpha": "0.1",
    "size": "0",
    "red": "0.55 + rand() * 0.15",
    "green": "0.85 + rand() * 0.12",
    "blue": "0.95 + rand() * 0.05",
    "custom": "gaussian()",
    "hitbox_size": 0.15
  },
  "ticker": {
    "dx": "(CUSTOM * 0.007) * sin(0.015 * AGE)",
    "dy": "(CUSTOM * 0.003) * cos(0.06 * AGE) - 0.006",
    "dz": "(CUSTOM * 0.007) * cos(0.015 * AGE)",
    "size": "(CUSTOM * 0.02 + 0.025) * sin((pi / LIFETIME) * AGE)",
    "alpha": "0.80 * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "DISTANCE_SQUARED > 256"
  },
  "tick_interval": 1,
  "render_type": "translucent",
  "liquid_affinity": "non_liquids",
  "rotation_mode": "look_at_xyz",
  "kill_on_contact": true,
  "random_sprite": true,
  "light_level": 4,
  "has_physics": true,
  "exclusion_radius": 1
}
