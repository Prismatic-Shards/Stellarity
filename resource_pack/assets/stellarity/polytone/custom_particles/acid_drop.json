  "particle_emitters": [
    {
      "particle": "stellarity:acid_splash",
      "chance": "AGE == LIFETIME",
      "x": "0",
      "y": "0.02",
      "z": "0"
    }
  ],
  "sound_emitters": [
    {
      "sound": "minecraft:block.lava.extinguish",
      "chance": 0.003,
      "volume": 0.45,
      "pitch": "1.3 + 0.3 * rand()"
    }
  ]
