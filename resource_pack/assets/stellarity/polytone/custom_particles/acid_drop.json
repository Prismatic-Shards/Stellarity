{
  "type": "custom",
  "initializer": {
    "lifetime": "35 + 15 * rand()",
    "alpha": "0.90",
    "size": "0.14",
    "red": "0.22",
    "green": "0.95",
    "blue": "0.65",
    "hitbox_size": 0.12
  },
  "ticker": {
    "dy": "-0.85",
