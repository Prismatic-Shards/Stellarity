{
  "type": "custom",
  "initializer": {
    "lifetime": "160 + 100 * rand()",
    "alpha": "0.1",
    "size": "0.12 + rand() * 0.08",
    "red": "0.92 + rand() * 0.08",
    "green": "0.85 + rand() * 0.15",
    "blue": "1.0",
    "custom": "rand() * 6.28"
  },
  "ticker": {
    "dx": "0.001 * sin(AGE * 0.02 + CUSTOM)",
    "dy": "0.0005",
    "dz": "0.001 * cos(AGE * 0.02 + CUSTOM)",
    "alpha": "(0.35 + 0.60 * abs(sin(CUSTOM + AGE * 0.25))) * sin((pi / LIFETIME) * AGE)",
    "size": "(0.14 + 0.08 * sin(CUSTOM + AGE * 0.30)) * sin((pi / LIFETIME) * AGE)",
    "remove_condition": "sqrt(DISTANCE_SQUARED) > 140"
  },
  "light_level": 15,
  "render_type": "additive_translucent",
  "rotation_mode": "look_at_player",
  "has_physics": false
}
